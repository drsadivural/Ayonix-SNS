{
  "name": "ayonix-sns",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @ayonix/web && npm run build -w @ayonix/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:contract && npm run test:reference",
    "test:unit": "vitest run --project unit",
    "test:contract": "npm run test -w @ayonix/worker",
    "test:reference": "cd handoff && npm test",
    "db:migrate:local": "npm run db:migrate:local -w @ayonix/worker",
    "dev": "npm run dev -w @ayonix/worker",
    "dev:web": "npm run dev -w @ayonix/web",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true
  }
}
